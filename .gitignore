# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real secrets — see .env.example)
.env
.env.local
.env.production
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
dev.log
server.log
dev.out.log

# IDE / editor
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS
Thumbs.db

# Local-only directories
.z-ai-config
.claude
.zscripts/
local-*
prompt
test

# Local SQLite database (re-created on `bun run db:push`)
db/*.db
db/*.db-journal

# Downloaded screenshots / artifacts
download/

# Skills directory (internal)
/skills/

# Build artifacts
mini-services/*/node_modules
mini-services/*/.next

# ──────────────────────────────────────────────────────────────────────────
# VaultLua — Environment Variables
# Copy this file to `.env` and fill in real values for your deployment.
# Never commit the real `.env` file. The server-only variables below MUST
# NOT be exposed to the browser (do not prefix them with NEXT_PUBLIC_).
# ──────────────────────────────────────────────────────────────────────────

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of the deployment (used for callbacks, links, CORS)
APP_URL=https://xyz.446.xyz

# Secret used to sign NextAuth JWTs — generate with `openssl rand -hex 32`
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Internal API secret for service-to-service calls (not exposed to browser)
API_SECRET=change-me-to-a-long-random-string

# Encryption key used for HMAC-signing reward sessions and other server-side
# crypto. Must be at least 32 characters. Generate with `openssl rand -hex 32`.
ENCRYPTION_KEY=change-me-to-a-32-char-minimum-random-string

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (development only)
DATABASE_URL=file:./db/vaultlua.db

# In production, swap to PostgreSQL (matches the Supabase schema 1:1):
# DATABASE_URL=postgresql://user:pass@host:5432/vaultlua?schema=public

# ── Supabase (production) ──────────────────────────────────────────────────
# These are SAFE to expose to the browser — they are the anon-key equivalent.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# This is the SERVICE-ROLE key. NEVER expose this to the browser. NEVER prefix
# with NEXT_PUBLIC_. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Discord Integration (optional) ─────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ── Reward Providers (optional — server-only) ──────────────────────────────
# Each provider's API token. NEVER expose these to the browser.
REWARD_PROVIDER_LOILO_API_TOKEN=
REWARD_PROVIDER_LOILO_WEBHOOK_SECRET=
REWARD_PROVIDER_ADGEM_APP_ID=
REWARD_PROVIDER_ADGEM_API_KEY=

# ── Feature Flags ──────────────────────────────────────────────────────────
# Optional: override feature flags via env. Dashboard can also toggle these.
FEATURE_DISCORD_BOT=true
FEATURE_REWARD_LINKS=true
FEATURE_API_V1=true
FEATURE_REALTIME_SESSIONS=true

# ── Rate Limiting ──────────────────────────────────────────────────────────
# Per-IP rate limits for public endpoints
RATE_LIMIT_REWARD_START_PER_MIN=10
RATE_LIMIT_REWARD_COMPLETE_PER_MIN=30
RATE_LIMIT_API_PER_HOUR=1000
